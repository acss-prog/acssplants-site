PORT=3000
MAIL_TO=acss.agricultura@gmail.com

# MailerSend API (keep the token server-side)
MAILERSEND_API_TOKEN=replace-with-mailersend-api-token

# Must be on a domain verified in MailerSend. Free-mail addresses
# (gmail.com, outlook.com, ...) are rejected with 422 / #MS42207 —
# see "Verify the sending domain" in README.md.
MAILERSEND_FROM_EMAIL=site@acssplants.pt
MAILERSEND_FROM_NAME=ACSS Plants

# Only needed when the static site is hosted on a different domain
ALLOWED_ORIGIN=https://www.your-domain.com
