PORT=3000
MAIL_TO=acss.agricultura@gmail.com

# Preferred: MailerSend API (keep the token server-side)
MAILERSEND_API_TOKEN=replace-with-mailersend-api-token
MAILERSEND_FROM_EMAIL=hello@your-verified-domain.com
MAILERSEND_FROM_NAME=ACSS Plants

# Optional SMTP fallback
MAIL_FROM=your-sender@your-domain.com
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=your-sender@your-domain.com
SMTP_PASS=replace-with-your-smtp-password
SMTP_TLS=true
SMTP_SSL=false
